# Copy to `.env`. Compose reads it automatically; `.env` is gitignored.
#
# Which load the backend serves. The committed seed loads as `downtown-dubai` (the default, so a
# fresh clone works with no configuration); a full `python -m twin.pipeline.city fetch` loads as
# `dubai-all`. Point the backend at whichever you actually loaded -- the API will tell you by name
# if you get it wrong.
SOLUM_AOI=downtown-dubai

# Local Postgres credential. The default is a development convenience and is safe only because the
# container publishes to localhost; anything reachable from outside the machine needs a real one.
POSTGRES_PASSWORD=solum
