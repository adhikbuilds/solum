# Copy to .env — .env is gitignored.
#
# Local (docker compose up -d):
DATABASE_URL=postgres://solum:solum@localhost:5433/solum

# Neon, when we move: same variable, add sslmode. No code changes.
# DATABASE_URL=postgres://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/solum?sslmode=require

# scripts/market-scrape only. Get a key at firecrawl.dev.
FIRECRAWL_API_KEY=

# Massing study service (massing/ + web/ on feat/massing-engine, run separately via
# `docker compose up` there). Rail.tsx links out to this rather than embedding it -- different
# architecture, unrelated git history. Unset falls back to the local dev port.
NEXT_PUBLIC_MASSING_URL=http://localhost:5180
